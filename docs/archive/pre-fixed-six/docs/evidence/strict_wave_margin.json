  "reproduction": "from universe24.core import Engine\nfrom universe24.core.lattice import DIRECTIONS, ZERO\nfrom universe24.tools.connected_clocks import build_candidate, _append_terms, perturb_seed\nfrom universe24.layers.strict_edge import single_edge_realization\nfrom universe24.prepare.strict_edge import lift_seed\n\nsource, seed, _, manifest = build_candidate(L=4, rng_seed=13, bridge=True)\nk = source.Q // 256\nwave_names = [name for name in source.names if name.startswith('metric.')]\nwave_names += ['em.A_x', 'em.A_y', 'em.A_z']\nextra = []\nfor name in wave_names:\n    g = source.gear_index(name)\n    extra.append((g, 6*k, ((g, ZERO, 'b'),)))\n    extra.extend((g, -k, ((g, e, 'b'),)) for e in DIRECTIONS)\ntuned = _append_terms(source, extra)\nrealization = single_edge_realization(tuned, stiffness=k)\ninitial = lift_seed(seed, realization)\nother_initial, _ = perturb_seed(realization.tensor, initial, direction='forward')\nengine = Engine(realization.tensor, realization.tensor.Q)\nleft, right = initial.copy(), other_initial.copy()\nfor tick in range(1, 1001):\n    left, right = engine.step(left), engine.step(right)\n    if tick in (300, 1000):\n        assert engine.rewind(left, tick).same_as(initial)\n        assert engine.rewind(right, tick).same_as(other_initial)\n",
