{
  "schema": "universe24-clock-long-runs-v1",
  "scope": "Completed exactly-rewound finite trajectories. Counter boundedness is only a statement about the audited prefix; no global stability, cosmological bounce, entropy optimization, synchronization, entanglement or GR theorem.",
  "algebra": {
    "D": "6*Q",
    "geometry": "Periodic cubic L by L by L grid; node flat index (x*L+y)*L+z; offsets wrap modulo L. Oriented-link gears use the source tensor's declared storage endpoints.",
    "state": "At every stored node:2G unbounded integer a/b counters andG Euclidean remainders. A finite board is not a finite state space and does not itself imply recurrence.",
    "local_input": "u is the fixed sparse tensor evaluation on the declared local stored variables",
    "update": "ell,r_next=divmod(2*u+r,D); a_next=b; b_next=ell-a",
    "arithmetic": "Exact signed integers, Euclidean remainder 0<=r<D; no clamping, reseeding, selectors or new forward primitive",
    "inverse": "The source old-a dependency graph is acyclic; Engine.inverse_step recovers its declared stages exactly. Added clock terms depend only on old b.",
    "free_metric": {
      "Q": 8589934593,
      "neighbor_u_coefficient": 8589934592,
      "onsite_u_coefficient": 6,
      "remainder_free_cos_omega": "1/Q + (Q-1)/(3Q)*(cos(kx)+cos(ky)+cos(kz))",
      "corner_cos_omega": "-1+2/Q",
      "interpretation": "The remainder-free linear free corner is near-marginal and oscillatory, not an exactly repeated -1 root. Forced/nonlinear growth was observed; tiny positive free headroom is not a nonlinear stability theorem."
    }
  },
  "recipes": {
    "default_jpure": {
      "builder": "one_system(); compose(*system.blocks); one_seed(system,tensor,L,bang='jpure',rng_seed=13)",
      "source_Q": 8589934593,
      "runtime_changes": false,
      "reproduce": "python -m universe24.tools.clock_epochs --L 3 --steps 5000 --max-counter-bits 256"
    },
    "low16": {
      "source": "default_jpure at the case L",
      "change": "Only initial matter.* a,b are divided by16 toward zero; every r and every tensor coefficient is unchanged",
      "reproduce": "python -m universe24.tools.clock_epochs --L <case L> --steps <completed_steps> --matter-divisor 16 --max-counter-bits 256",
      "interpretation": "Preparation restriction, not a repair or proof of stability of the original default seed"
    },
    "component_star_D256": {
      "source": "default_jpure L3,rng13",
      "k": "floor(D/256)",
      "ports": [
        "ref.R00",
        "su2.psi_1",
        "su3.psi_0r",
        "u1.psi_re",
        "metric.h0x",
        "metric.h0y",
        "metric.h0z",
        "metric.hxx",
        "metric.hyy",
        "metric.hzz",
        "metric.hxy",
        "metric.hxz",
        "metric.hyz",
        "arm1.X0",
        "cosmic.dp"
      ],
      "tensor_assembly": "Copy source GearType objects and normalized (target,coefficient,factors) monomials without source designation annotations; append bus.C and the declared new inputs. This preserves source dynamics, not all source metadata.",
      "added_state": "bus.C at every node: a=0,b=1024,r=3Q-1; official label",
      "added_inputs": "For each port j: u_j += k*(C-b_j); u_C += k*(b_j-C)",
      "status": "Rejected engineering control; arbitrary component ports do not preserve full multiplet symmetry"
    },
    "component_star_D4096": {
      "source": "component_star_D256 recipe, but k=floor(D/4096)",
      "status": "Rejected engineering control"
    },
    "public_connected_clocks_rng13": {
      "builder": "universe24.tools.connected_clocks.build_candidate(L=<case L>,rng_seed=13)",
      "preset": {
        "resolution_factor": 268435456,
        "matter_divisor": 16,
        "clock_amplitude": 512,
        "gauge_probe": 512,
        "metric_probe": 32,
        "spring_divisor": 64,
        "bridge_divisor": 256
      },
      "initial_preparation": "Matter a,b /16 toward zero; gauge scalar probes at node0; nine non-h00 metric gears b=32*(-1)^(x+y+z),a=-b; homogeneous resolution lift scales source tensor,Q,r byM; new clocks a=b=512,r=3Q_lifted-1",
      "norm_port_potential": "Phi=-lambda*c^2*(sum_i w_i*(b_i+v_i)^2-E0)/2; u_j=s_j*dPhi/db_j. Link ports sum the two endpoint clock squares. Complete declared forms, not individual components.",
      "couplings": "lambda=M for ordinary forms,lambda=1 for metric forms; u_clock free=(D/2)*c; reciprocal master-sector spring D/64; spatial_spring=0",
      "record_bridge": "Phi=-kappa*c_cosmic*(dp+dm), kappa=D/256; reciprocal equal input to the matched recording pair",
      "locality": "Added clock monomials have single-edge support. The unchanged source contains multi-edge terms; these runs do not certify the stricter locality condition for the complete source.",
      "reproduce": "python -m universe24.tools.connected_clocks --L <case L> --rng 13 --steps 5000 --max-counter-bits 256"
    },
    "public_connected_clocks_rng17": {
      "source": "Same frozen public_connected_clocks preset, with L6 and rng_seed17; no new tuning",
      "reproduce": "python -m universe24.tools.connected_clocks --L 6 --rng 17 --steps 5000 --max-counter-bits 256"
    }
  },
  "diagnostic_units": {
    "hash": "universe24-state-values-v2 SHA256 of exact integer values, geometry and shape; independent of int64/object storage",
    "counter_bits": "Maximum absolute a/b counter bit length; remainders can be larger and are bounded separately byD",
    "metric": "F=b[metric.h00]; U=F/(2P), P=1048576. Mean/corner numerators are exact integer sums divided by node count.",
    "phase": "Opposite-nonzero-sign crossings of sum_x b_cosmic.Th; same-direction intervals are computational updates, not physical proper time or bangs",
    "records": "Number of records in the official stream, not sum of quotient weights and not entropy or complexity",
    "counter_gate": "Terminate after the first completed update exceeding256 a/b bits; preserve that state for rewind, never clamp it",
    "MI": "Sign of summed signed official quotient per namespace/update; fixed256-update windows, lags1,2,4,8,16;20shuffle and20nonzero circular-shift controls. Descriptive means, no significance or entanglement claim",
    "MI_reproduction": "NumPy default_rng(771), initialized once; full windows only. Pair order cosmic/matter,cosmic/su2,cosmic/su3,cosmic/u1,bus/matter, skipping absent namespaces; then ascending lag. Use x[:-lag],y[lag:]. Each of20 iterations draws permutation(y), then roll(y,integers(1,len(y))). Empirical discrete MI uses base2; average control MI within windows, then average the retained window values."
  },
