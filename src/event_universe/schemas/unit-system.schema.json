{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Closer24/Universe24/main/src/event_universe/schemas/unit-system.schema.json",
  "title": "Explicit coherent rational SI calibration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_id",
    "base_scales",
    "units"
  ],
  "properties": {
    "model_id": {
      "const": "si-rational-v1"
    },
    "base_scales": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/ratio"
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "dimensions",
          "si_scale"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "dimensions": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": {
              "type": "integer",
              "minimum": -16,
              "maximum": 16
            }
          },
          "si_scale": {
            "$ref": "#/$defs/ratio"
          }
        }
      }
    }
  },
  "$defs": {
    "ratio": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 115792089237316195423570985008687907853269984665640564039457584007913129639935
      }
    }
  }
}
