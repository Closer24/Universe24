+"""hr1: the horizon radiates nothing by the clicks (the test for tests/test_the_node.py's side, under 15 s): the 3-cube's centre fed to the frozen content with its before slot 93 contents below (a Node risen into the horizon), the light at the centre four times the sea's; 60 intervals under FR-S1's form: the centre is frozen at no two intervals in a row, its content stays within the band [the floor's turn, the crossing value] and returns to the frozen content (a refreeze), 0 clicks at the centre and at its six neighbours, the neighbours' content rises (the write feeds the well, nothing drains it), every integer within 128 bits, the run back exact 60 of 60. Run: FR2_RELEASE=1 PYTHONPATH=<src with FR-S1> pytest tests_hr1.py"""
+import copy
+import sys
+
+import numpy as np
+
+sys.set_int_max_str_digits(0)
+from event_universe.core import paces
+from event_universe.features import volume
+from event_universe.loader.world import load_world
+from event_universe.node import Node
+from event_universe.rows import CARRIER
+
+WORLD = "tests/worlds/world_node.json"
+
+
+def test_the_released_node_hovers_and_the_clicks_show_nothing_of_it():
+    universe, world = load_world(WORLD)
+    node = Node(universe, world)
+    centre = tuple(int(s) // 2 for s in node.shape)
+    cube = int(node.shape[0])
+    frozen = int(paces.frozen_content(node.gamma))
+    level = lambda c: int(np.asarray(volume.volume_of(node.gamma, np.array([c], dtype=object)), dtype=object).reshape(-1)[0])
+    carrier = node.row(CARRIER).lines[0]
+    carrier.now[centre] = level(frozen)
+    carrier.before[centre] = level(frozen - 93)
+    node.ride_walls()
+    light = node.emitter().lines[0]
+    light.now[centre] = 4 * int(light.now[centre])
+    x, y, z = centre
+    nb = [((x + d) % cube, y, z) for d in (1, -1)] + [(x, (y + d) % cube, z) for d in (1, -1)] + [(x, y, (z + d) % cube) for d in (1, -1)]
+    states, course, frozen_flags, nb_first = [], [], [], None
+    for k in range(60):
+        states.append(node.state_bytes())
+        node.step()
+        c = node.content()
+        pace = np.asarray(paces.link_pace_of(node.gamma, c), dtype=object)
+        course.append(int(c[centre]))
+        frozen_flags.append(bool(pace[centre] == 0))
+        if nb_first is None:
+            nb_first = [int(c[p]) for p in nb]
+        assert node.census()[1] <= 128 and int(node.max_transient) <= 128
+    assert not any(a and b for a, b in zip(frozen_flags, frozen_flags[1:]))  # FR-S1: no two frozen intervals in a row
+    assert sum(frozen_flags) >= 2  # the Node refreezes: it hovers at the horizon
+    assert min(course) < frozen <= max(course)  # the band: below the horizon and back to it
+    clicks = [e for e in node.log if e["event"] in ("birth", "credit") and (tuple(e["node"]) == centre or tuple(e["node"]) in nb)]
+    assert clicks == []  # the clicks show nothing at the horizon or beside it
+    nb_last = [int(node.content()[p]) for p in nb]
+    assert all(b >= a for a, b in zip(nb_first, nb_last)) and sum(nb_last) > sum(nb_first)  # the write feeds the neighbours; nothing drains the well
+    for k in range(60):
+        node.step_back()
+        assert node.state_bytes() == states[59 - k]
