+def recoil(
+    node: Node, where: tuple[int, ...], dp: list[int], clock: int, direction: int
+) -> dict[str, Any]:
+    """The move's recoil written on the Link's record the Node holds (the flag LT1_RECOIL; the lay as the take reversed, RW-S1 read on the Link's record): the momentum a move books at its Node (momentum_of, the change of the records' current on the Node's six Links) is written per axis on the carrier's flux line at that Node by the Node's one write act (one carried division at the line's write wall, the carry in its write remainder; Y-S3's line, whose source summed over the board is the records' momentum negated, so the records' loss is the line's gain at the sign of the booking, at the clock squared by the position of the reading), in the direction given; at -1 the same write undone from the log's numbers. Returns the log's numbers (the clock, the levels laid per axis, the carry before and after), nothing with the flag empty."""
+    if not os.environ.get("LT1_RECOIL"):
+        return {}
+    lines = node.row(CARRIER).lines[1 + AXES : 1 + AXES + AXES]
+    was, laid = [int(line.wr[where]) for line in lines], []
+    for line, p in zip(lines, dp, strict=True):
+        numerator = zeros(node.shape)
+        numerator[where] = p * clock * clock
+        level = int(line.now[where])
+        node.write(line, numerator, direction)
+        laid.append(int(line.now[where]) - level)
+    return {"clock": clock, "recoil": laid, "carry_was": was, "carry": [int(line.wr[where]) for line in lines]}
