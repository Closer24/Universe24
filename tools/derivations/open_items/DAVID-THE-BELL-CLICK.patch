+def _bell_opposite(c: int, room: int, d1: tuple[int, ...], d2: tuple[int, ...]) -> bool:
+    """Born's odds for the partner against the closed axis, on integers: opposite where (2 c - room) |d1| |d2| < room (d1 . d2)."""
+    left, right = c + c - room, room * sum(a * b for a, b in zip(d1, d2, strict=True))
