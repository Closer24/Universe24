+def bell_turn(q: tuple[int, ...], twins: tuple[int, ...]) -> tuple[int, ...]:
+    """The twins turned by a detector's quaternion (a, b, c, d), the doublet's one turn on integers as a hand's turn by a Gaussian is the singlet's: the up twin u0 + u1 i and the down twin v0 + v1 i go to (a - d i) u + (-c - b i) v and (c - b i) u + (a + d i) v, their winds times a^2 + b^2 + c^2 + d^2."""
+    a, b, c, d = q
+    u0, u1, v0, v1 = twins
+    return (
+        a * u0 + d * u1 - c * v0 + b * v1,
+        a * u1 - d * u0 - c * v1 - b * v0,
+        c * u0 + b * u1 + a * v0 - d * v1,
+        c * u1 - b * u0 + a * v1 + d * v0,
+    )
+
