+            c, room = drawn
+            bit = int(choices[int(remainder(len(index["answered"]), len(choices)))])
+            q = tuple(int(x) for x in turns[end][bit])
+            partner = index["answered"].get((fit, 1 - end))
+            if partner is None:
+                twins: tuple[int, ...] = (1, 0, 1, 0)
+                closed = 0
+            else:
+                first, (a, b, k, d) = partner
