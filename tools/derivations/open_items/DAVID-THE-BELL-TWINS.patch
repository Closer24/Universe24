+def _bell_index(clock: Any) -> dict[str, Any]:
+    """The born pairs and their answered ends read from the log, rebuilt where the log was cut back (the rewind)."""
+    held = _BELL_INDEX.get(id(clock))
+    stale = (
+        held is None
+        or len(clock.log) < held["n"]
+        or (held["n"] > 0 and clock.log[held["n"] - 1] is not held["last"])
+    )
+    found: dict[str, Any] = (
+        {"n": 0, "by_child": {}, "answered": {}, "last": None} if stale or held is None else held
+    )
+    _BELL_INDEX[id(clock)] = found
+    for pos in range(found["n"], len(clock.log)):
+        e = clock.log[pos]
+        if e["event"] == "birth":
+            for end, where in enumerate((e["minus"], e["plus"])):
+                found["by_child"].setdefault((tuple(where), int(e["line_pair"])), []).append(
+                    (int(e["i"]), pos, end)
+                )
+        elif e["event"] == "credit" and "bell" in e:
+            b = e["bell"]
+            found["answered"][(b["pair"], b["end"])] = (b["answer"], tuple(b["turn"]))
+    found["n"] = len(clock.log)
+    found["last"] = clock.log[-1] if clock.log else None
+    return found
