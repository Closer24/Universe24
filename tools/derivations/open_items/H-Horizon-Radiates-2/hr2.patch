--- a/tests/test_horizon_radiates.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_horizon_radiates.py	2026-10-26 03:58:16.969868780 +0000
@@ -0,0 +1,89 @@
+"""hr2 (H-Horizon-Radiates-2): the test of the row "the horizon radiates" under FR-S1's form (the flag FR2_RELEASE on the flagged copy; on the head the two lines in place): the 3-cube of tests/worlds/world_node.json with its centre fed to the frozen content and its before below it, 40 intervals. What the law does, asserted: (a) no Node is frozen at two intervals in a row (FR-S1); (b) the released centre's content stays between the floor's reflection and the horizon and returns to the horizon (the hover: frozen lines at the centre at least 5 of 40); (c) the content reaches the six neighbours by their own read within two intervals and the neighbours stand at the horizon within ten: the horizon's neighbourhood grows and does not empty; (d) no credit is written at the centre, at its neighbours, or anywhere on the board over the 40 intervals (the law's clicks carry nothing of the horizon); (e) the run back 40 of 40 by the state's hash; (f) every transient within 128 bits. Usage: FR2_RELEASE=1 PYTHONPATH=<src copy> python test_horizon_radiates_hr2.py [world.json]; also collected by pytest."""
+import os
+import sys
+import time
+
+import numpy as np
+
+os.environ.setdefault("FR2_RELEASE", "1")
+sys.set_int_max_str_digits(0)
+from event_universe.core import paces  # noqa: E402
+from event_universe.features import volume  # noqa: E402
+from event_universe.loader.world import load_world  # noqa: E402
+from event_universe.node import Node  # noqa: E402
+from event_universe.rows import CARRIER  # noqa: E402
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+WORLD = os.path.join(HERE, "worlds", "world_node.json")
+
+
+def fed_node(world_path, content, before):
+    universe, world = load_world(world_path)
+    node = Node(universe, world)
+    centre = tuple(int(s) // 2 for s in node.shape)
+
+    def level_at(c):
+        return int(np.asarray(volume.volume_of(node.gamma, np.array([c], dtype=object)), dtype=object).reshape(-1)[0])
+
+    carrier = node.row(CARRIER).lines[0]
+    carrier.now[centre] = level_at(content)
+    carrier.before[centre] = level_at(before)
+    node.ride_walls()
+    light = node.emitter().lines[0]
+    light.now[centre] = 4 * int(light.now[centre])
+    return node, centre
+
+
+def neighbours_of(centre, shape):
+    out = []
+    for ax in range(3):
+        for d in (-1, 1):
+            q = list(centre)
+            q[ax] = (q[ax] + d) % shape[ax]
+            out.append(tuple(q))
+    return out
+
+
+def test_the_horizon_radiates_nothing_and_its_neighbourhood_grows(world_path=WORLD, n=40):
+    frozen_content = paces.frozen_content(1000)
+    node, centre = fed_node(world_path, frozen_content, frozen_content - 93)
+    shape = tuple(int(s) for s in node.shape)
+    nbs = neighbours_of(centre, shape)
+    hashes, prev_frozen, two_in_row = [], set(), 0
+    centre_frozen, centre_contents, first_nb_content, nb_at_horizon = 0, [], None, None
+    max_transient = 0
+    for t in range(n):
+        hashes.append(node.state_hash())
+        node.step()
+        c = node.content()
+        pace = np.asarray(paces.link_pace_of(node.gamma, c), dtype=object)
+        frozen = {tuple(int(v) for v in idx) for idx in zip(*np.nonzero(pace == 0))}
+        two_in_row += len(frozen & prev_frozen)
+        prev_frozen = frozen
+        centre_frozen += centre in frozen
+        centre_contents.append(int(c[centre]))
+        if first_nb_content is None and all(int(c[p]) > 0 for p in nbs):
+            first_nb_content = node.interval
+        if nb_at_horizon is None and all(int(pace[p]) == 0 for p in nbs):
+            nb_at_horizon = node.interval
+        max_transient = max(max_transient, int(node.max_transient))
+    credits = [e for e in node.log if e.get("event") == "credit"]
+    exact = 0
+    for k in range(n):
+        node.step_back()
+        exact += node.state_hash() == hashes[n - 1 - k]
+    found = {"two in a row": two_in_row, "centre frozen lines": centre_frozen, "centre content min/max": [min(centre_contents), max(centre_contents)], "neighbours read the content at": first_nb_content, "neighbours at the horizon at": nb_at_horizon, "credits": len(credits), "run back": [exact, n], "max transient bits": max_transient}
+    assert two_in_row == 0, found  # (a)
+    assert centre_frozen >= 5 and min(centre_contents) > 0 and max(centre_contents) >= frozen_content, found  # (b)
+    assert first_nb_content is not None and first_nb_content <= 2, found  # (c) the content reaches the neighbours by their own read
+    assert nb_at_horizon is not None and nb_at_horizon <= 10, found  # (c) the neighbourhood grows to the horizon
+    assert len(credits) == 0, found  # (d)
+    assert exact == n, found  # (e)
+    assert max_transient <= 128, found  # (f)
+    return found
+
+
+if __name__ == "__main__":
+    t0 = time.monotonic_ns()
+    found = test_the_horizon_radiates_nothing_and_its_neighbourhood_grows(sys.argv[1] if len(sys.argv) > 1 else WORLD)
+    print(found, "ms", (time.monotonic_ns() - t0) // 1000000)
diff -ruN a/tools/hr2/hr2_stream.py b/tools/hr2/hr2_stream.py
--- a/tools/hr2/hr2_stream.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/hr2/hr2_stream.py	2026-10-26 03:58:16.972734183 +0000
@@ -0,0 +1,143 @@
+"""hr2 (H-Horizon-Radiates-2): one world run N intervals on a named src (the flag FR2_RELEASE from the environment), a reading per interval streamed as a JSON line as it comes: the frozen set, the turned among the Nodes that ever froze, the content and X at every Node that ever froze, the sum of content over the horizon's neighbourhood (every Node that ever froze and its six neighbours) against the rest of the board, the credits and births of the interval with their Node, their distance in Links from the nearest Node that ever froze (the torus), their levels, beat, proper and content, the max transient and state bits; then the run back of `back` by the state's hash; the final JSON with the counts and the whole click log (births and credits). Integers only. Usage: hr2_stream.py <src> <world.json> <intervals> <back> <out.jsonl> <final.json> [fed content] [fed before content]"""
+import json
+import sys
+import time
+
+import numpy as np
+
+sys.path.insert(0, sys.argv[1])
+sys.set_int_max_str_digits(0)
+from event_universe.core import paces  # noqa: E402
+from event_universe.features import volume  # noqa: E402
+from event_universe.loader.world import load_world  # noqa: E402
+from event_universe.node import Node  # noqa: E402
+from event_universe.rows import CARRIER  # noqa: E402
+
+src, world_path, n, back, out_path, final_path = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4]), sys.argv[5], sys.argv[6]
+universe, world = load_world(world_path)
+node = Node(universe, world)
+shape = tuple(int(s) for s in node.shape)
+cube = shape[0]
+fed = None
+if len(sys.argv) > 8:
+    content_fed, before_fed = int(sys.argv[7]), int(sys.argv[8])
+    centre = tuple(s // 2 for s in shape)
+
+    def level_at(c):
+        return int(np.asarray(volume.volume_of(node.gamma, np.array([c], dtype=object)), dtype=object).reshape(-1)[0])
+
+    carrier = node.row(CARRIER).lines[0]
+    carrier.now[centre] = level_at(content_fed)
+    carrier.before[centre] = level_at(before_fed)
+    node.ride_walls()
+    light = node.emitter().lines[0]
+    light.now[centre] = 4 * int(light.now[centre])
+    fed = {"centre": list(centre), "content": content_fed, "before": before_fed, "X": level_at(content_fed), "X before": level_at(before_fed)}
+
+
+def at(i):
+    return (i // (cube * cube), (i // cube) % cube, i % cube)
+
+
+def index(p):
+    return p[0] * cube * cube + p[1] * cube + p[2]
+
+
+def dist(a, b):
+    return sum(min((x - y) % cube, (y - x) % cube) for x, y in zip(a, b))
+
+
+def neighbours(i):
+    p = at(i)
+    out = set()
+    for ax in range(3):
+        for d in (-1, 1):
+            q = list(p)
+            q[ax] = (q[ax] + d) % cube
+            out.add(index(tuple(q)))
+    return out
+
+
+ever = []  # the Nodes that ever froze, in order of first freeze
+ever_set = set()
+hood = set()  # ever frozen and their six neighbours
+first_freeze = {}
+hashes = []
+log_seen = 0
+frozen_content = paces.frozen_content(node.gamma)
+t0 = time.monotonic_ns()
+out = open(out_path, "w", encoding="utf-8")
+max_transient = 0
+max_state = 0
+for t in range(n):
+    if back and t >= n - back:
+        hashes.append(node.state_hash())
+    node.step()
+    i = node.interval
+    carrier = node.row(CARRIER).lines[0]
+    c = node.content()
+    cflat = [int(x) for x in np.asarray(c, dtype=object).reshape(-1)]
+    xflat = [int(x) for x in np.asarray(carrier.now, dtype=object).reshape(-1)]
+    pace = [int(p) for p in np.asarray(paces.link_pace_of(node.gamma, c), dtype=object).reshape(-1)]
+    frozen = [k for k, p in enumerate(pace) if p == 0]
+    for k in frozen:
+        if k not in ever_set:
+            ever_set.add(k)
+            ever.append(k)
+            first_freeze[k] = i
+            hood.add(k)
+            hood |= neighbours(k)
+    turned_flat = node.turned.reshape(-1).tolist()
+    new_log = node.log[log_seen:]
+    log_seen = len(node.log)
+    clicks = []
+    for e in new_log:
+        if e.get("event") not in ("birth", "credit"):
+            continue
+        p = tuple(int(v) for v in e["node"])
+        d = min((dist(p, at(k)) for k in ever), default=None)
+        clicks.append({"event": e["event"], "node": list(p), "index": index(p), "dist": d, "levels": int(e.get("levels", 0)), "beat": int(e.get("beat", 0)) if e["event"] == "credit" else None, "proper": int(e.get("proper", 0)), "content": int(e.get("content", 0)), "sense": e.get("sense"), "line": e.get("line", e.get("line_pair")), "turned": e.get("turned")})
+    census = node.census()
+    max_transient = max(max_transient, int(node.max_transient))
+    max_state = max(max_state, int(census[1]))
+    line = {
+        "i": i,
+        "frozen": frozen,
+        "turned_ever": [k for k in ever if turned_flat[k]],
+        "content_ever": {str(k): cflat[k] for k in ever},
+        "X_ever": {str(k): xflat[k] for k in ever},
+        "hood_size": len(hood),
+        "hood_content_sum": sum(cflat[k] for k in hood),
+        "rest_content_sum": sum(cflat[k] for k in range(len(cflat)) if k not in hood),
+        "board_content_sum": sum(cflat),
+        "max_content": max(cflat),
+        "clicks": clicks,
+        "credits": sum(1 for e in clicks if e["event"] == "credit"),
+        "births": sum(1 for e in clicks if e["event"] == "birth"),
+        "max_transient_bits": int(node.max_transient),
+        "state_bits": int(census[1]),
+        "ms": (time.monotonic_ns() - t0) // 1000000,
+    }
+    if fed is not None:
+        ci = index(tuple(fed["centre"]))
+        line["centre"] = {"content": cflat[ci], "X": xflat[ci], "X_before": int(carrier.before.reshape(-1)[ci]), "turned": bool(turned_flat[ci]), "frozen": pace[ci] == 0, "proper": int(node.proper.reshape(-1)[ci])}
+        line["centre_neighbours_content"] = [cflat[k] for k in sorted(neighbours(ci))]
+    out.write(json.dumps(line, default=str) + "\n")
+    if i % 50 == 0 or i == n:
+        out.flush()
+out.close()
+exact = 0
+for k in range(len(hashes)):
+    node.step_back()
+    exact += node.state_hash() == hashes[len(hashes) - 1 - k]
+final = {
+    "src": src, "world": world_path, "intervals": n, "fed": fed, "frozen content": frozen_content, "cube": cube,
+    "ever frozen": [{"index": k, "node": list(at(k)), "first freeze": first_freeze[k]} for k in ever],
+    "hood": sorted(hood), "run back": [exact, len(hashes)],
+    "counts": {k: int(v) for k, v in node.counts.items()}, "turns": len(node.turns) if isinstance(node.turns, list) else int(node.turns),
+    "max transient bits": max_transient, "max state bits": max_state,
+    "ms": (time.monotonic_ns() - t0) // 1000000,
+    "clicks": [e for e in node.log if e.get("event") in ("birth", "credit")],
+}
+json.dump(final, open(final_path, "w"), default=str)
+print(json.dumps({k: v for k, v in final.items() if k != "clicks"}, default=str)[:3000])
diff -ruN a/tools/hr2/read_stream.py b/tools/hr2/read_stream.py
--- a/tools/hr2/read_stream.py	1970-01-01 00:00:00.000000000 +0000
