+# where every line below `pair_rule` runs main's path bit for bit.
+import os as _os
+
+PAIR_RIDES = _os.environ.get("U24_PAIR_RIDES") == "1"
+NUMS: dict[tuple[int, int], Any] = {}
+
+
+def link_nums(nums: Any) -> tuple[Any, ...]:
+    """The Link's num read the same from both ends, the lesser of its two ends' nums, per Port in Port order (the variant's mending rule for the current's antisymmetry: R_ij / p_i^2 = R_ji / p_j^2 needs one num per Link)."""
+    own = np.asarray(nums, dtype=object)
+    return tuple(np.minimum(own, arrival(own, axis, side)) for axis, side in PORT_SIDES)
+
+
+def pair_rule(nums: Any, den: Any, gamma: Any, clock: Any, pace: Any, factors: Factors | None, unit: Any) -> Rule:
+    """Rule3's integers with the Node's own pair: D_i = 12 (den - num_i) p_0^2 G^2 from the Node's num_i, R_ij = 2 num_ij p_i^2 Q_ij G^2 with num_ij the Link's num (`link_nums`), S_i = 2 w - D_i - SUM_j R_ij."""
+    square = unit * unit
+    links = (square,) * PORTS if factors is None else factors
+    pace_squared = np.asarray(pace, dtype=object) * np.asarray(pace, dtype=object)
+    reaches = tuple(2 * pace_squared * factor * num for factor, num in zip(links, link_nums(nums), strict=True))
+    wall = 6 * den * gamma * gamma * square
+    own = 12 * (den - np.asarray(nums, dtype=object)) * np.asarray(clock, dtype=object) * np.asarray(clock, dtype=object) * square
+    return Rule(reaches, wall + wall - own - sum(reaches), wall, own)
+
 
