{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universe24 result v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_status": {
      "enum": [
        "completed",
        "error",
        "budget_exhausted"
      ]
    },
    "implementation_status": {
      "enum": [
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "scope": {
      "enum": [
        "full",
        "bundle_only"
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "steps",
          "first_full_state_return",
          "expected_first_return",
          "final_equals_initial",
          "arithmetic_event_count",
          "full_state_inverse_pass",
          "pass"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "integer",
            "minimum": 0
          },
          "first_full_state_return": {},
          "expected_first_return": {
            "type": "integer",
            "minimum": 1
          },
          "final_equals_initial": {
            "type": "boolean"
          },
          "arithmetic_event_count": {
            "type": "integer",
            "minimum": 0
          },
          "full_state_inverse_pass": {
            "type": "boolean"
          },
          "pass": {
            "type": "boolean"
          }
        }
      }
    },
    "negative_claim_result": {
      "type": "object"
    },
    "suite": {
      "type": "object"
    },
    "reflection_certificate_equal": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "protocol_id",
    "execution_status",
    "implementation_status",
    "scope",
    "cases",
    "negative_claim_result",
    "suite",
    "reflection_certificate_equal",
    "errors"
  ]
}
