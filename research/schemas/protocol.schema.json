{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universe24 protocol v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "base_engine_commit": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "specification_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "observation": {
      "type": "string",
      "minLength": 1
    },
    "success": {
      "type": "string",
      "minLength": 1
    },
    "negative_claim": {
      "type": "string",
      "minLength": 1
    },
    "budget_wall_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "[a-z0-9_]+"
          },
          "config": {
            "type": "string",
            "minLength": 1
          },
          "expected_first_return": {
            "type": "integer",
            "minimum": 1
          },
          "expected_steps": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "config",
          "expected_first_return",
          "expected_steps"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "protocol_id",
    "question",
    "base_engine_commit",
    "specification_sha256",
    "observation",
    "success",
    "negative_claim",
    "budget_wall_seconds",
    "cases"
  ]
}
