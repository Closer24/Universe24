{
  "schema_version": 1,
  "model_id": "small-space-scalar-flux-vector-exchange-probe-v1",
  "shape": [9, 9, 9],
  "boundary": "open",
  "slots_per_node": 2,
  "link_ticks": 1,
  "normal_budget": 100000,
  "ticks": 3,
  "operation_costs": {
    "receive": 1, "read": 1, "evaluate": 1, "update": 1, "couple": 1,
    "route": 1, "split": 1, "send": 1, "commit": 1
  },
  "fields": [
    {
      "name": "strength", "components": 1, "units": "source units per field interval",
      "signed": false, "conserved": true, "extensive": true
    },
    {
      "name": "radiation", "components": 1, "units": "transported scalar unit",
      "signed": true, "conserved": true, "extensive": true
    },
    {
      "name": "momentum", "components": 3, "units": "abstract vector stock unit",
      "signed": true, "conserved": true, "extensive": true
    },
    {
      "name": "polarity", "components": 1, "units": "signed response multiplier",
      "signed": true, "conserved": false, "extensive": false
    }
  ],
  "disturbance_types": [
    {
      "name": "stationary_source", "fields": ["strength"],
      "defaults": {"strength": 216}, "transport": {"mode": "hold"}
    },
    {
      "name": "held_receiver", "fields": ["momentum", "polarity"],
      "defaults": {"momentum": [0, 0, 0], "polarity": 1},
      "transport": {"mode": "hold"}
    }
  ],
  "spatial_fields": [
    {
      "field": "radiation", "baseline": 0, "transport": "outward",
      "axis_weights": [1, 1, 1], "octant_weights": [1, 1, 1, 1, 1, 1, 1, 1]
    },
    {"field": "momentum", "baseline": [0, 0, 0], "transport": "local"}
  ],
  "emissions": [
    {
      "type": "stationary_source", "field": "radiation",
      "amount": {"field": "strength"}, "denominator": 1, "source": true
    }
  ],
  "spatial_couplings": [
    {
      "name": "delivered_scalar_flux_exchange", "type": "held_receiver",
      "field": "momentum", "mode": "exchange",
      "amount": {
        "op": "neg", "args": [
          {"op": "mul", "args": [{"field": "polarity"}, {"flux": "radiation"}]}
        ]
      },
      "denominator": 1
    }
  ],
  "seeds": [
    {"position": [4, 4, 4], "type": "stationary_source"},
    {"position": [5, 4, 4], "type": "held_receiver"}
  ]
}
